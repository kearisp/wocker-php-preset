{
    "name": "php",
    "version": "2.0.0",
    "type": "dockerfile",
    "dockerfile": "./.wocker/Dockerfile",
    "buildArgsOptions": {
        "IMAGE_VERSION": {
            "message": "Image version",
            "type": "select",
            "hash": false,
            "options": [
                "5.6-apache",
                "7.4-apache",
                "8.2-apache",
                "8.3-apache",
                "8.4-apache",
                "8.5-apache"
            ]
        },
        "PHP_EXTENSIONS": {
            "message": "Extensions",
            "type": "select",
            "mode": "variable",
            "delimiter": ",",
            "multiple": true,
            "options": {
                "pdo_mysql": "Mysql PDO",
                "mysqli": "Mysqli",
                "pgsql": "Pgsql",
                "pdo_pgsql": "Postgres PDO",
                "gd": "GD",
                "exif": "Exif",
                "zip": "Zip",
                "memcache": "Memcache",
                "memcached": "Memcached",
                "http": "Raphf+Http",
                "intl": "Intl",
                "pcntl": "Pcntl",
                "soap": "Soap",
                "xdebug": "XDebug",
                "uopz": "Uopz",
                "gettext": "GetText",
                "bcmath": "Bcmath",
                "sockets": "Sockets",
                "imagick": "Imagick",
                "redis": "Redis",
                "ldap": "Ldap",
                "mongodb": "Mongodb",
                "iconv": "Iconv",
                "opcache": "Opcache",
                "sodium": "Sodium"
            }
        },
        "XDEBUG_MODE": {
            "message": "Xdebug mode",
            "type": "select",
            "when": {
                "variable": "PHP_EXTENSIONS",
                "includes": "xdebug"
            },
            "options": [
                "off",
                "develop",
                "coverage",
                "debug",
                "gcstats",
                "profile",
                "trace"
            ],
            "default": "debug"
        },
        "COMPOSER_ENABLE": {
            "message": "Install composer?",
            "type": "boolean",
            "default": false
        },
        "COMPOSER_ALLOW_SUPERUSER": {
            "when": {
                "variable": "COMPOSER_ENABLE",
                "equals": "true"
            },
            "message": "Composer allow superuser?",
            "type": "boolean",
            "default": false
        },
        "SLIM_IMAGE": {
            "message": "Remove build tools (compilers, -dev headers) after build to shrink the image? Disable if you need to compile things (e.g. npm native modules) inside the running container.",
            "type": "boolean",
            "default": false
        },
        "NODE_VERSION": {
            "message": "Node version",
            "type": "select",
            "options": [
                {
                    "label": "none",
                    "value": ""
                },
                "v17.9.1",
                "v18.16.0",
                "v20.19.5",
                "v22.19.0",
                "v23.11.1",
                "v24.9.0",
                "v25.2.1"
            ]
        },
        "NODE_PACKAGE_MANAGER": {
            "message": "Package manager",
            "type": "select",
            "when": {
                "variable": "NODE_VERSION",
                "notEquals": ""
            },
            "options": ["npm", "pnpm", "yarn"]
        }
    },
    "envOptions": {
        "APACHE_DOCUMENT_ROOT": {
            "type": "string",
            "message": "Apache document root",
            "default": "/var/www"
        }
    },
    "volumeOptions": [
        "./:/var/www"
    ]
}
